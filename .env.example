# Copy to .env for local docker compose testing.
# On CapRover, set the same variables in App Config -> Environment Variables.

TZ=Europe/Berlin

# Set to 1 to run the web installer automatically on first container start.
EFACLOUD_AUTO_INSTALL=0

# Used only by the in-container bootstrap script. Leave default for CapRover.
EFACLOUD_BASE_URL=http://127.0.0.1

# Database connection (CapRover internal host example: srv-captain--efacloud-db)
EFACLOUD_DB_HOST=db
EFACLOUD_DB_NAME=efacloud
EFACLOUD_DB_USER=efacloud
EFACLOUD_DB_PASSWORD=change-me

# First efaCloud admin user
EFACLOUD_ADMIN_FIRST=Club
EFACLOUD_ADMIN_LAST=Admin
EFACLOUD_ADMIN_EMAIL=admin@your-club.example
EFACLOUD_ADMIN_ID=1142
EFACLOUD_ADMIN_NAME=clubadmin
EFACLOUD_ADMIN_PASSWORD=change-me-too

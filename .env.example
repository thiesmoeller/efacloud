# Copy to .env for local docker compose testing.
# On CapRover, set the same variables in App Config -> Environment Variables.
# Use separate CapRover apps/DBs for staging vs production — see docs/deploy/.

TZ=Europe/Berlin

# Set to 1 to run the web installer automatically on first container start.
# Skips when installation is complete (install/.locked or config/.install_complete).
# Resumes when settings exist but setup was interrupted.
EFACLOUD_AUTO_INSTALL=0

# Used only by the in-container bootstrap script. Leave default for CapRover.
EFACLOUD_BASE_URL=http://127.0.0.1

# Database connection (CapRover internal host example: srv-captain--efacloud-db)
# Staging example: srv-captain--efacloud-staging-db
EFACLOUD_DB_HOST=db
EFACLOUD_DB_NAME=efacloud
EFACLOUD_DB_USER=efacloud
EFACLOUD_DB_PASSWORD=change-me

# First efaCloud admin user
EFACLOUD_ADMIN_FIRST=Club
EFACLOUD_ADMIN_LAST=Admin
EFACLOUD_ADMIN_EMAIL=admin@your-club.example
EFACLOUD_ADMIN_ID=1142
EFACLOUD_ADMIN_NAME=clubadmin
EFACLOUD_ADMIN_PASSWORD=change-me-too

# Local-only: force portal API to use fixtures/sanitized (never set on CapRover).
# Requires fixtures mounted or present on the filesystem — not in production images.
# EFACLOUD_PORTAL_FIXTURES=1

# TLS / Secure cookies (CapRover): CapRover's edge nginx terminates HTTPS and
# forwards plain HTTP to the container with X-Forwarded-Proto: https (and often
# X-Forwarded-Ssl). Portal_session trusts that header so session cookies get the
# Secure flag on public HTTPS. Local plain-HTTP compose labs omit the header and
# keep non-Secure cookies so browser sessions still work on http://127.0.0.1.
# Do not strip X-Forwarded-Proto on CapRover. Optional local drill:
#   ./scripts/https-cookie-drill.sh

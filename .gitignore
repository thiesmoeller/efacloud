.DS_Store
.env
*.zip

# Generated by the efacloud installer. Never commit real database credentials.
config/settings_db
config/settings/dbSettings
config/.install_complete

# Runtime data
log/*
!log/.htaccess
uploads/*
!uploads/.htaccess
attachements/*
!attachements/.htaccess
pdfs/*
!pdfs/.htaccess

# Installer lock / resume markers
install/.locked
install/.db_ready

# Local club backup extracts (PII). Keep sanitized fixtures only.
fixtures/efa-backup/
test_backup/

# Ephemeral compose override written by backup-activation-rehearsal.sh
.compose.rehearsal.override.yml

# Local / ops scratch under var/ (never commit secrets or drill artifacts)
var/
var/caprover-staging-secrets.env
var/restore-drill/

# Demo / lab secrets and Python junk
demo/out/CREDENTIALS.*
**/__pycache__/
*.py[cod]
lab/.venv/
.venv/

# Compiled desktop posttx probe (javac --release 17 into lab/desktop_synch/bin/)
lab/desktop_synch/bin/

# Portal frontend deps / local build (image builds dist in Docker multi-stage)
portal/node_modules/
portal/dist/
portal/e2e/node_modules/
portal/e2e/package-lock.json

# efaStats frontend deps / local build
stats/node_modules/
stats/dist/
